DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
AUTO_UPDATE=false
TZ=Asia/Seoul

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
LLM_TIMEOUT_SECONDS=90

# Discord review channel (#03-검수대기)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_TIMEOUT_SECONDS=30

# Marketing pipeline
MARKETING_SCHEDULER_ENABLED=false
MARKETING_RUN_TIME=09:00
MARKETING_SOURCE_TOPIC=홍대에서 외국인 친구와 치맥하기 좋은 이유
STORE_NAME=굽네치킨 홍대 레드로드점

# Optional Google Drive markdown sync for Obsidian sources
GDRIVE_SERVICE_ACCOUNT_JSON_B64=
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_SYNC_INTERVAL=900
GDRIVE_LOCAL_PATH=/root/.hermes/drive/obsidian

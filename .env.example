DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
AUTO_UPDATE=false
TZ=Asia/Seoul

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_CONTENT_MODEL=
OPENROUTER_TOPIC_MODEL=
OPENROUTER_BLOG_REVIEW_MODEL=
LLM_TIMEOUT_SECONDS=90

# Discord review channel (#03-검수대기)
# Existing Railway projects may already use DISCORD_WEBHOOK_승인대기.
DISCORD_WEBHOOK_REVIEW=
DISCORD_WEBHOOK_검수대기=
DISCORD_WEBHOOK_승인대기=
DISCORD_WEBHOOK_짧은글=
DISCORD_WEBHOOK_블로그=
DISCORD_WEBHOOK_인스타=
DISCORD_WEBHOOK_촬영지시서=
DISCORD_WEBHOOK_플레이스=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_SHORT_DRAFT=
DISCORD_CHANNEL_BLOG_DRAFT=
DISCORD_CHANNEL_CARDNEWS_DRAFT=
DISCORD_CHANNEL_SHOOTING_GUIDE=
DISCORD_CHANNEL_REVIEW=
DISCORD_CHANNEL_PLACE_DRAFT=
DISCORD_TIMEOUT_SECONDS=30

# Marketing pipeline
MARKETING_SCHEDULER_ENABLED=false
MARKETING_RUN_TIME=09:00
MARKETING_SOURCE_TOPIC=홍대에서 외국인 친구와 치맥하기 좋은 이유
STORE_NAME=굽네치킨 홍대 레드로드점
MARKETING_BLOG_REVIEW_MAX_TOKENS=1600

# Optional Google Drive markdown sync for Obsidian sources
GDRIVE_SERVICE_ACCOUNT_JSON_B64=
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_SYNC_INTERVAL=900
GDRIVE_LOCAL_PATH=/root/.hermes/drive/obsidian
GDRIVE_SOURCE_SUBPATH=02_wiki
MARKETING_REQUIRE_OBSIDIAN=true
